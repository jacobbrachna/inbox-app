{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "InboxPro",
  "version": "0.1.0",
  "identifier": "com.jacobbrachna.inboxpro",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://localhost:3030",
    "beforeDevCommand": {
      "script": "npm run dev",
      "wait": false
    },
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "InboxPro",
        "url": "http://localhost:3030",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/jacobbrachna/inbox-app/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGQzgwMjgyMjBBMzY3QjAKUldTd1o2TWdnZ0xJdjgrdFNRck82eStmYUdzU0tUanZQMUtpYW5TRUZhaU1KV2w2Tnc4RjdKV2kK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "../scripts/bootstrap.sh"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "Developer ID Application: Jacob Brachna-Gonzalez (AP3VSH77V4)"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
