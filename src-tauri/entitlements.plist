<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Node.js V8 needs to allocate JIT pages; without this the hardened
         runtime refuses and the app crashes on first JS execution. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- better-sqlite3 + sharp ship native .node files; without library-
         validation disabled the hardened runtime refuses to dlopen them. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Standalone Next.js reads env / writes to ~/Library/Application Support. -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
</dict>
</plist>
